{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://98.88.118.95/api/:path*" },
    { "source": "/t/:path*", "destination": "http://98.88.118.95/t/:path*" },
    { "source": "/u/:path*", "destination": "http://98.88.118.95/u/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
